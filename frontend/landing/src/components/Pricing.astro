---
const botUsername = import.meta.env.PUBLIC_BOT_USERNAME || "entrenadorax_bot";

const planes = [
  {
    nombre: "Free",
    precio_mes: "$0",
    precio_anual: "$0",
    badge: null,
    features: [
      "Bot conversacional 24/7",
      "Onboarding completo + compromiso",
      "Escalation diaria",
      "1 foto comida/dia",
      "1 PR registrado",
      "Charts basicos",
      "Deporte principal",
    ],
    cta: "Empezar gratis",
  },
  {
    nombre: "Starter",
    precio_mes: "$5.000",
    precio_anual: "$48.000 ($4K/mes)",
    badge: "Mas comprado",
    features: [
      "Todo Free",
      "Photo comida ILIMITADO",
      "Charts avanzados (streak + macros + analisis)",
      "Mini App completo",
      "1 analisis mensual PDF",
      "1 deporte secundario",
      "5 min Realtime trial mensual",
      "Soporte 60+ deportes",
    ],
    cta: "Elegir Starter",
  },
  {
    nombre: "Pro",
    precio_mes: "$14.990",
    precio_anual: "$144.000 ($12K/mes)",
    badge: "Mas popular",
    popular: true,
    features: [
      "Todo Starter",
      "Voz TTS ilimitada en escalation",
      "30 min Realtime/mes (llamadas con coach)",
      "1 wearable (Whoop/Garmin/Strava)",
      "Plan generator semanal con LLM",
      "Stickers exclusivos",
      "Export CSV ilimitado",
      "Deportes ilimitados",
    ],
    cta: "Elegir Pro",
  },
  {
    nombre: "Elite",
    precio_mes: "$39.990",
    precio_anual: "$384.000 ($32K/mes)",
    badge: null,
    features: [
      "Todo Pro",
      "120 min Realtime/mes",
      "Wearables ilimitados",
      "Analisis mensual PDF ilimitado",
      "Beta features early access",
      "Priority support",
      "1 sesion coach humano hibrido/mes",
      "Kudos x3 multiplicador",
      "Badge Elite en canal comunidad",
    ],
    cta: "Elegir Elite",
  },
];
---
<section id="precios" class="bg-slate-900 text-white py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-center">Precios desde $5.000 COP</h2>
    <p class="text-center text-slate-300 mt-3 max-w-2xl mx-auto">
      Pagas por Bre-B/Nequi/Daviplata/Bancolombia. El bot valida tu comprobante con Vision AI
      y activa el plan inmediato. Un humano valida en menos de 24h. Si rechazamos, te devolvemos
      todo. <b>Sin tarjeta. Sin subscripcion oculta.</b>
    </p>

    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {planes.map((plan) => (
        <div
          class={`rounded-2xl p-6 border relative ${plan.popular ? "border-brand-400 bg-gradient-to-b from-brand-900/80 to-slate-800 ring-1 ring-brand-400/50" : "border-slate-700 bg-slate-800"}`}
        >
          {plan.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold uppercase tracking-wider">
              {plan.badge}
            </div>
          )}
          <h3 class="text-xl font-bold">{plan.nombre}</h3>
          <div class="mt-3">
            <span class="text-4xl font-bold">{plan.precio_mes}</span>
            <span class="text-slate-400 text-sm"> /mes</span>
          </div>
          <div class="mt-1 text-xs text-slate-400">
            anual {plan.precio_anual}
          </div>
          <ul class="mt-5 space-y-2 text-sm text-slate-200">
            {plan.features.map((f) => (
              <li class="flex gap-2">
                <span class="text-brand-400 font-bold">+</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href={`https://t.me/${botUsername}?start=ref_landing_${plan.nombre.toLowerCase()}`}
            class={`mt-6 block text-center rounded-lg px-4 py-3 font-semibold transition ${plan.popular ? "bg-brand-500 text-white hover:bg-brand-400" : "bg-white text-slate-900 hover:bg-slate-100"}`}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-2xl bg-gradient-to-r from-brand-700/60 to-brand-900/60 border border-brand-500 p-6 text-center">
      <div class="text-xs uppercase tracking-wider text-brand-300 font-semibold">Solo en launch</div>
      <h3 class="mt-2 text-2xl font-bold">Lifetime $399.000 COP unico</h3>
      <p class="mt-2 text-sm text-slate-200 max-w-2xl mx-auto">
        Todo Elite para siempre. Sin renovacion. <b>100 cupos disponibles en lanzamiento.</b>
        Recuperas la inversion en 17 meses al precio Elite.
      </p>
      <a
        href={`https://t.me/${botUsername}?start=ref_landing_lifetime`}
        class="mt-4 inline-block rounded-lg bg-amber-400 text-amber-950 px-6 py-3 font-bold hover:bg-amber-300"
      >
        Reservar Lifetime
      </a>
    </div>

    <p class="text-center mt-8 text-xs text-slate-400">
      Estudiantes con .edu.co: 50% off Starter/Pro permanente.
      Pago anual: 2 meses gratis (20% descuento).
      Referidos: 1 mes Pro gratis para invitador e invitado.
    </p>
  </div>
</section>
