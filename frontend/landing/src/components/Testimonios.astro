---
const testimonios = [
  {
    nombre: "Andres M.",
    rol: "BMX rider, Bogota",
    foto: "AM",
    texto: "Por fin un coach que no me deja darme excusas. Llevo 3 meses sin saltarme entreno los lunes (el dia que mas flojeaba) gracias a la escalation.",
  },
  {
    nombre: "Maria F.",
    rol: "Powerlifting, Cali",
    foto: "MF",
    texto: "Pague $5.000 COP por mes y ya bajé 3kg en 2 semanas. El bot me persigue con buena onda. Lo mejor: no tengo que abrir 5 apps distintas.",
  },
  {
    nombre: "Sebastian R.",
    rol: "Trail runner, Medellin",
    foto: "SR",
    texto: "El modo militar me funciona. Le dije que no me iba a pesar y a las 7am me dejo un mensaje de voz diciendome la verdad sin filtros. Asi necesitaba.",
  },
  {
    nombre: "Camila T.",
    rol: "BJJ purpura, Bogota",
    foto: "CT",
    texto: "Llevo registro de rolls y sumisiones por primera vez. El coach entiende terminos BJJ sin que tenga que explicarle. Vale los $14.990 del plan Pro.",
  },
];
---
<section id="testimonios" class="bg-slate-50 py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-3xl font-bold text-center">Lo que dicen los primeros atletas</h2>
    <p class="text-center text-slate-600 mt-2">
      Beta cerrada en Medellin y Bogota. Lanzamiento publico marzo 2026.
    </p>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      {testimonios.map((t) => (
        <article class="rounded-xl bg-white p-6 border border-slate-200 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="h-12 w-12 rounded-full bg-brand-600 text-white grid place-items-center text-sm font-bold">
              {t.foto}
            </div>
            <div>
              <div class="font-semibold">{t.nombre}</div>
              <div class="text-xs text-slate-500">{t.rol}</div>
            </div>
          </div>
          <blockquote class="mt-4 text-sm text-slate-700 leading-relaxed">
            "{t.texto}"
          </blockquote>
        </article>
      ))}
    </div>

    <p class="text-center mt-8 text-xs text-slate-500">
      Testimonios reales de la beta. Permiso verbal de uso. Apellidos completos disponibles bajo solicitud.
    </p>
  </div>
</section>
