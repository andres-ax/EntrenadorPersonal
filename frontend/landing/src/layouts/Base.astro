---
import { SEO } from "astro-seo";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "EntrenadorAX - El coach que NO te deja en paz cuando fallas",
  description = "Coach IA personal en Telegram. Pagos por Bre-B/Nequi desde $5.000 COP. 60+ deportes soportados.",
  canonical,
} = Astro.props;

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: "/og-image.png",
          url: canonical || Astro.site?.toString() || "/",
        },
        optional: {
          description,
          siteName: "EntrenadorAX",
        },
      }}
      twitter={{
        creator: "@entrenadorax",
        card: "summary_large_image",
      }}
    />
    {plausibleDomain && (
      <script
        defer
        is:inline
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}
  </head>
  <body class="font-sans bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
