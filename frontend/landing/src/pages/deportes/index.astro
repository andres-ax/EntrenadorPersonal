---
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import { DEPORTES, CATEGORIA_LABELS, type CategoriaDeporte } from "../../data/deportes";

// Agrupar por categoria.
const porCategoria = DEPORTES.reduce<Record<CategoriaDeporte, typeof DEPORTES>>((acc, d) => {
  if (!acc[d.categoria]) acc[d.categoria] = [] as any;
  acc[d.categoria].push(d);
  return acc;
}, {} as any);

const ORDEN: CategoriaDeporte[] = [
  "urbano",
  "combate",
  "equipo",
  "individual_outdoor",
  "indoor",
  "acuatico",
  "ecuestre",
  "tradicional_co",
  "motor",
];
---
<Base
  title={`${DEPORTES.length} deportes soportados - EntrenadorAX`}
  description={`Coach IA en Telegram para ${DEPORTES.length} deportes practicados en Colombia. BMX, skate, rollers, climbing, padel, MMA, ciclismo, halterofilia y mas. Cada uno con metricas propias.`}
  canonical={new URL("/deportes", Astro.site).toString()}
>
  <Navbar />
  <main class="mx-auto max-w-6xl px-4 py-12">
    <header>
      <h1 class="text-4xl md:text-5xl font-bold">{DEPORTES.length} deportes soportados</h1>
      <p class="mt-3 text-lg text-slate-600 max-w-3xl">
        EntrenadorAX se adapta a tu deporte. No solo gym. Cada deporte tiene metricas propias,
        vocabulario reconocido por el coach, y tools especificas (PRs polimorficos, sesiones de skill,
        sparring, peleas, vias enviadas, trucos aterrizados, vueltas...). Elige el tuyo:
      </p>
    </header>

    <nav class="mt-8 flex flex-wrap gap-2 sticky top-4 z-10 bg-white/80 backdrop-blur p-3 rounded-lg border border-slate-200">
      {ORDEN.filter((c) => porCategoria[c]).map((c) => (
        <a
          href={`#${c}`}
          class="rounded-full bg-slate-100 hover:bg-brand-100 px-3 py-1 text-xs font-medium"
        >
          {CATEGORIA_LABELS[c]} ({porCategoria[c].length})
        </a>
      ))}
    </nav>

    {ORDEN.filter((c) => porCategoria[c]).map((c) => (
      <section id={c} class="mt-12 scroll-mt-24">
        <h2 class="text-2xl font-semibold border-b border-slate-200 pb-2">
          {CATEGORIA_LABELS[c]}
        </h2>
        <div class="mt-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {porCategoria[c].map((d) => (
            <a
              href={`/deportes/${d.slug}`}
              class="group rounded-xl border border-slate-200 p-4 hover:border-brand-500 hover:bg-brand-50 transition"
            >
              <div class="font-semibold group-hover:text-brand-700">{d.nombre}</div>
              <div class="text-xs text-slate-500 mt-1 line-clamp-2">
                {d.metricas}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>
