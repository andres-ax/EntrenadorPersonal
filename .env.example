# =============================================================================
# EntrenadorAX - Plantilla de variables de entorno
# Copia a .env y rellena con valores reales. NUNCA commitees .env.
# =============================================================================

# Entorno: dev | prod | test
ENV=dev

# --- REQUERIDAS ---

# Token del bot de Telegram (obtener con @BotFather)
TELEGRAM_TOKEN=

# API key de OpenAI (Agents SDK + TTS + Vision)
OPENAI_API_KEY=

# Cadena de conexion PostgreSQL.
# Acepta postgresql:// (Railway) o postgresql+asyncpg:// (correcto).
# El bot normaliza automaticamente a +asyncpg.
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/entrenadorax

# URL de Redis (sesiones, rate-limit, cache).
REDIS_URL=redis://localhost:6379/0

# --- OPCIONALES (con defaults razonables) ---

# URL publica donde se expone /webhook (modo produccion FastAPI)
# WEBHOOK_BASE_URL=https://entrenadorax.tuapp.dev

# Secret para X-Telegram-Bot-Api-Secret-Token. Si no se setea, se genera uno
# aleatorio al primer arranque (NO recomendado en produccion: cambia tras
# cada deploy). En Railway/Render setealo manualmente y configura el webhook
# con setWebhook?secret_token=<valor>.
# WEBHOOK_SECRET=

# Token para proteger endpoints administrativos (/admin/*, /webhook-info).
# Si no se setea, se genera uno aleatorio (cambia tras cada deploy).
# ADMIN_TOKEN=

# Secret SEPARADO para firmar JWTs del Mini App. NO usar el mismo que admin_token.
# Genera con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Chat ID de Telegram al que se envian alertas de errores (tu user id personal).
# Obtener enviando un mensaje a @userinfobot.
# DEVELOPER_CHAT_ID=123456789

# --- TUNING (opcional) ---

# Pool de conexiones SQLAlchemy
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=30
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=300

# Memoria conversacional del agente
# SESSION_LIMIT=20
# SESSION_TTL_SECONDS=2592000

# Limites por usuario
# RATE_LIMIT_PER_MINUTE=10
# MAX_MESSAGE_CHARS=4000

# Anti-DoS
# MAX_WEBHOOK_PAYLOAD_BYTES=1000000

# Zona horaria por defecto si el usuario no la setea
# DEFAULT_TIMEZONE=America/Bogota
