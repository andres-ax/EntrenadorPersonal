# =============================================================================
# EntrenadorAX - Variables de entorno
# Copia a .env y rellena. NUNCA commitees .env.
# =============================================================================

# Entorno: dev | prod | test
ENV=dev

# --- REQUERIDAS ---

# Token del bot Telegram (obtener con @BotFather)
TELEGRAM_TOKEN=

# API key de OpenAI (Agents SDK + TTS + Vision + Realtime)
OPENAI_API_KEY=

# Postgres. Railway expone postgresql://, el bot normaliza a +asyncpg.
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/entrenadorax

# Redis (sesiones, rate-limit, cache, pubsub).
REDIS_URL=redis://localhost:6379/0


# --- WEB / URLS ---
# En produccion usamos los dominios *.up.railway.app que provee Railway.
# Si en el futuro consigues un dominio propio (ej. entrenadorax.com),
# basta con cambiar estos valores y rebuildear los frontends.

# URL publica del webhook (https). Modo produccion FastAPI.
# WEBHOOK_BASE_URL=https://entrenadorpersonal-production.up.railway.app

# URLs de los frontends para CORS + setChatMenuButton.
# MINIAPP_URL=https://entrenadorpersonal-production.up.railway.app
# LANDING_URL=https://entrenadorpersonal-production.up.railway.app
# ADMIN_URL=https://entrenadorax-admin-production.up.railway.app
# REALTIME_WS_URL=wss://entrenadorpersonal-production.up.railway.app/ws/realtime


# --- SECRETOS ---

# Secret para X-Telegram-Bot-Api-Secret-Token (genera con `openssl rand -hex 32`)
# WEBHOOK_SECRET=

# Token root para acceso admin sin login (uso emergencia / scripts).
# ADMIN_TOKEN=

# JWT secret separado (Mini App + admin login).
# Genera con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Fernet key para cifrado de tokens OAuth de wearables.
# Genera con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# Chat ID admin para alertas (enviar mensaje a @userinfobot).
# DEVELOPER_CHAT_ID=123456789


# --- PRICING TIERS ---

# Override de precios (defaults: starter 5000, pro 14990, elite 39990, lifetime 399000)
# PRECIO_STARTER_COP=5000
# PRECIO_PRO_COP=14990
# PRECIO_ELITE_COP=39990
# PRECIO_LIFETIME_COP=399000
# DESCUENTO_ANUAL_PCT=20
# CUPOS_LIFETIME_TOTAL=100

# Cuentas donde recibes pagos (muestra al usuario en /pagar).
# CUENTA_DESTINO_PAGO=300 123 4567
# CUENTA_DESTINO_ALT=Bancolombia ahorros 1234567890

# Tolerancia (+/- COP) al comparar monto del comprobante con monto esperado.
# MONTO_PAGO_TOLERANCIA_COP=500
# REFERIDO_DIAS_BONUS=30


# --- CANALES Y COMUNIDAD ---

# Chat IDs de canales Telegram donde el bot publica (debe ser admin del canal).
# CANAL_LOGROS_ID=-1001234567890
# CANAL_PRO_ID=-1009876543210


# --- WEARABLES OAuth (Fase 6) ---

# Whoop https://developer.whoop.com
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=

# Strava https://developers.strava.com
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Garmin Connect https://developer.garmin.com
# GARMIN_CLIENT_ID=
# GARMIN_CLIENT_SECRET=

# Google Fit https://console.cloud.google.com
# GOOGLE_FIT_CLIENT_ID=
# GOOGLE_FIT_CLIENT_SECRET=


# --- EMAIL (Fase 9 magic link) ---

# Resend https://resend.com (free 100 emails/dia)
# RESEND_API_KEY=re_xxx


# --- OBSERVABILIDAD ---

# Sentry DSN (opcional pero recomendado en prod)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Plausible Analytics dominio (opcional)
# PLAUSIBLE_DOMAIN=entrenadorpersonal-production.up.railway.app


# --- TUNING ---

# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=30
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=300

# SESSION_LIMIT=20
# SESSION_TTL_SECONDS=2592000

# RATE_LIMIT_PER_MINUTE=10
# MAX_MESSAGE_CHARS=4000
# MAX_WEBHOOK_PAYLOAD_BYTES=1000000

# DEFAULT_TIMEZONE=America/Bogota
